# The standard catalog: every refactoring here is a composition of primitives and other refactorings, or an intent:
# what is to hold at the end (want), in the knowledge's language, with nothing of how; the knowledge deduces the
# changes, and what they break. The coherence engine verifies and repairs the result, so scripts state intent, not care.
# No code of any language is written here: a body is said in the body language (#{x} names the element x), and each
# projection writes it in its own.

refactoring generate-getter "A public method getX that answers the value of a field x"
  param field : element(FIELD) "the field to read"
  getter := create METHOD ${owner(field)} get${cap(name(field))}
  set ${getter} visibility public
  set ${getter} static ${attr(field, "static")}
  set ${getter} type ${type(field)}
  create STATEMENT ${getter} "" facts="body=return #{field}"
  return ${getter}
end

refactoring generate-setter "A public method setX(x) that gives a field x a value"
  param field : element(FIELD) "the field to write"
  setter := create METHOD ${owner(field)} set${cap(name(field))}
  set ${setter} visibility public
  set ${setter} static ${attr(field, "static")}
  p := create PARAM ${setter} ${name(field)}
  set ${p} type ${type(field)}
  create STATEMENT ${setter} "" facts="body=#{field} = #{p}"
  return ${setter}
end

refactoring encapsulate-field "Accessors for a field; uses outside its type go through them; the field becomes private"
  param field : element(FIELD) "the field to encapsulate"
  getter := generate-getter ${field}
  setter := generate-setter ${field}
  for r in refs(field) | not-within top(field)
    if eq(mode(r), "read")
      retarget ${r} ${getter}
    else
      retarget ${r} ${setter}
    end
  end
  set ${field} visibility private
  return ${field}
end

intent pull-up-field "Moves a field to the superclass of its type"
  param field : element(FIELD) "the field to move up"
  want given parent(field, t) and given superclass(t, u) and parent(field, u)
end

refactoring pull-up-method "Moves a method to the superclass of its type"
  param method : element(METHOD) "the method to move up"
  require nonempty(superclass(owner(method))) "${qualified(owner(method))} has no superclass"
  move ${method} ${superclass(owner(method))}
  return ${method}
end

intent extract-superclass "Creates a class between a type and its superclass and pulls fields up into it"
  param type : element(CLASS) "the type to extract from"
  param name : text "name of the new superclass" default "Abstract${name(type)}"
  param fields : elements(FIELD) "fields to pull up" from "fields(type)"
  want given parent(type, p) and given not member(_, p, name, _) and member(b, p, name, "class")
    and in-between(b, type) and superclass(type, b) and each f in fields: parent(f, b)
end

refactoring rename-method-family "Renames a method with every method it overrides or that overrides it"
  param method : element(METHOD) "any method of the family"
  param name : text "the new name" default "${name(method)}"
  for m in family(method)
    rename ${m} ${name}
  end
  return ${method}
end

refactoring move-members "Moves members to another class, as IntelliJ's Move Members: what used them from elsewhere names their new class; one there is not is created beside theirs"
  param members : elements(FIELD,METHOD) "the members to move"
  param to : text "the class they go to, by its qualified name (a new one may be named alone)"
  let t = find(to)
  if empty(t)
    t := create CLASS ${owner(top(first(members)))} ${simple(to)}
    require or(eq(qualified(t), to), eq(name(t), to)) "${to} would not be beside ${qualified(top(first(members)))}"
  end
  for m in members
    move ${m} ${t}
  end
  return ${t}
end

refactoring move-type "Moves a top-level type to another package"
  param type : element(CLASS,INTERFACE) "the type to move"
  param package : element(PACKAGE) "the destination package"
  move ${type} ${package}
  return ${type}
end

refactoring safe-delete "Deletes an element if nothing uses it"
  param element : element(FIELD,METHOD) "what to delete"
  delete ${element}
end

refactoring introduce-factory "Static factory for a constructor; every new outside it goes through the factory"
  param constructor : element(CONSTRUCTOR) "the constructor to hide"
  param name : text "name of the factory method" default "create${name(owner(constructor))}"
  f := create METHOD ${owner(constructor)} ${name}
  set ${f} visibility public
  set ${f} static true
  set ${f} type ${name(owner(constructor))}
  for p in params(constructor)
    q := create PARAM ${f} ${name(p)}
    set ${q} type ${type(p)}
  end
  create STATEMENT ${f} "" facts="body=return new #{constructor}(#{params(f)})"
  for r in refs(constructor) | not-within f
    retarget ${r} ${f}
  end
  set ${constructor} visibility private
  return ${f}
end

refactoring encapsulate-fields "Encapsulates every public field of a type, skipping the ones that cannot be"
  param type : element(CLASS) "the type whose public fields to encapsulate"
  for f in fields(type) | with-attr "visibility=public"
    try "${qualified(f)}"
      encapsulate-field ${f}
    end
  end
  return ${type}
end

refactoring copy-signature "Declares a method's signature, without a body, in another type"
  param method : element(METHOD) "the method whose signature to copy"
  param into : element(CLASS,INTERFACE) "where to declare it"
  d := create METHOD ${into} ${name(method)}
  set ${d} type ${type(method)}
  for p in params(method)
    q := create PARAM ${d} ${name(p)}
    set ${q} type ${type(p)}
  end
  if nonempty(attr(method, "throws"))
    set ${d} throws ${attr(method, "throws")}
  end
  if eq(kind(into), "CLASS")
    set ${d} visibility ${attr(method, "visibility")}
  end
  set ${d} abstract true
  return ${d}
end

refactoring declare-abstract-in-superclass "Declares a method abstract in the superclass of its type"
  param method : element(METHOD) "the method to declare"
  require nonempty(superclass(owner(method))) "${qualified(owner(method))} has no superclass"
  copy-signature ${method} ${superclass(owner(method))}
  set ${superclass(owner(method))} abstract true
  return ${method}
end

refactoring extract-interface "Creates an interface with some methods of a type, and the type implements it"
  param type : element(CLASS) "the type to extract from"
  param name : text "name of the new interface" default "I${name(type)}"
  param methods : elements(METHOD) "the methods the interface declares" from "methods(type)"
  i := create INTERFACE ${owner(type)} ${name}
  for m in methods
    copy-signature ${m} ${i}
  end
  link ${type} implements ${i}
  return ${i}
end

refactoring rename-field-with-accessors "Renames a field together with its getter and setter, if it has them"
  param field : element(FIELD) "the field to rename"
  param name : text "the new name" default "${name(field)}"
  let getter = first(methods(owner(field)) | named concat("get", cap(name(field))))
  let setter = first(methods(owner(field)) | named concat("set", cap(name(field))))
  rename ${field} ${name}
  if nonempty(getter)
    rename ${getter} get${cap(name)}
  end
  if nonempty(setter)
    rename ${setter} set${cap(name)}
  end
  return ${field}
end

refactoring inline-method "Replaces every call of a method by its body, then deletes it"
  param method : element(METHOD) "a method whose body is a single return, or statements called as one"
  # the last first: inlining a use renumbers the uses after it in its method
  for r in reversed(refs(method))
    inline ${r}
  end
  delete ${method}
end

refactoring inline-variable "Replaces every read of a local by the value it is given, then deletes it"
  param local : element(LOCAL) "a local given its value where it is declared, and never again"
  # the last first: inlining a use renumbers the uses after it in its method
  for r in reversed(refs(local))
    inline ${r}
  end
  delete ${local}
end

refactoring extract-method "Moves a run of statements into a new private method and calls it"
  param method : element(METHOD) "the method the statements are in"
  param lines : lines "first-last line of the statements"
  param name : text "name of the new method" default "extracted"
  m := extract ${method} ${lines} ${name}
  return ${m}
end

refactoring push-down-member "Moves a member into the only subclass of its type"
  param member : element(FIELD,METHOD) "the member to push down"
  let subs = subclasses(owner(member))
  require eq(count(subs), 1) "${qualified(owner(member))} must have exactly one subclass"
  move ${member} ${first(subs)}
  return ${member}
end

refactoring pull-up-unifying "Moves a member up to its superclass; the same member in the other subclasses goes into it"
  param member : element(FIELD,METHOD) "the member to move up"
  let sup = superclass(owner(member))
  require nonempty(sup) "${qualified(owner(member))} has no superclass in the workspace"
  move ${member} ${sup}
  for s in subclasses(sup)
    let twin = member-named(s, member)
    if nonempty(twin)
      if and(eq(type(twin), type(member)), eq(body(twin), body(member)), eq(attr(twin, "static"), attr(member, "static")))
        delete ${twin} into=${member}
      end
    end
  end
  return ${member}
end

refactoring collapse-hierarchy "Merges a class into its superclass: its members go up and its uses use the superclass"
  param type : element(CLASS) "the class to merge away"
  let sup = superclass(type)
  require nonempty(sup) "${qualified(type)} has no superclass in the workspace"
  require empty(constructors(type)) "${qualified(type)} has constructors; ${qualified(sup)} has no equivalent"
  for m in members(type)
    move ${m} ${sup}
  end
  for r in refs(type)
    retarget ${r} ${sup}
  end
  delete ${type}
end

refactoring redirect-uses "Points every use of an element at another of the same kind"
  param from : element(FIELD,METHOD) "the element whose uses move"
  param to : element(FIELD,METHOD) "the element they use instead"
  for r in refs(from)
    retarget ${r} ${to}
  end
  return ${to}
end

refactoring merge-duplicate "Keeps one of two methods with the same body: uses of the other go to it, the other goes"
  param keep : element(METHOD) "the method to keep"
  param duplicate : element(METHOD) "the method to drop"
  require eq(body(keep), body(duplicate)) "${qualified(keep)} and ${qualified(duplicate)} have different bodies"
  delete ${duplicate} into=${keep}
  return ${keep}
end

refactoring generalize-declared-type "Declares a field, parameter or local with one of its supertypes"
  param element : element(FIELD,PARAM,LOCAL) "the field, parameter or local"
  param type : element(CLASS,INTERFACE) "the supertype to declare it with"
  link ${element} declared ${type}
  return ${element}
end

refactoring rename-package "Moves every type of a package to a new package"
  param package : element(PACKAGE) "the package to rename"
  param name : text "the new qualified name" default "${qualified(package)}"
  p := create PACKAGE name=${name}
  for t in types-of(package)
    move-type ${t} ${p}
  end
  return ${p}
end

refactoring generate-constructor "A constructor that takes a value for each field given, and assigns it"
  param type : element(CLASS) "the class"
  param fields : elements(FIELD) "the fields it sets" from "fields(type)"
  c := create CONSTRUCTOR ${type} ${name(type)}
  set ${c} visibility public
  for f in fields
    p := create PARAM ${c} ${name(f)}
    set ${p} type ${type(f)}
    create STATEMENT ${c} "" facts="body=#{f} = #{p}"
  end
  return ${c}
end

refactoring convert-local-to-field "Makes a local a field of its type, as IntelliJ's Convert Local to Field: its declaration gives the field its value"
  param local : element(LOCAL) "the local"
  let method = owner(local)
  f := create FIELD ${owner(method)} ${name(local)}
  set ${f} visibility private
  set ${f} static ${attr(method, "static")}
  set ${f} type ${type(local)}
  delete ${local} into=${f}
  return ${f}
end

refactoring make-final "Makes a field final: nothing may assign it but where it is declared or a constructor"
  param field : element(FIELD) "the field"
  set ${field} final true
  return ${field}
end

refactoring make-static "Makes a method static: it may use nothing of an object"
  param method : element(METHOD) "the method"
  set ${method} static true
  return ${method}
end

refactoring generate-delegates "Methods that hand each call on to what a field holds, as IntelliJ's Delegate Methods"
  param field : element(FIELD) "the field that does the work"
  param methods : elements(METHOD) "the methods to hand on" from "methods(declared-type(field))"
  for m in methods
    d := create METHOD ${owner(field)} ${name(m)}
    set ${d} visibility public
    set ${d} type ${type(m)}
    for p in params(m)
      q := create PARAM ${d} ${name(p)}
      set ${q} type ${type(p)}
    end
    create STATEMENT ${d} "" facts="body=return #{field}.#{m}(#{params(d)})"
  end
  return ${field}
end

refactoring rename-with-delegate "Renames a method and keeps its old name as a method that calls the new one, for who still calls it"
  param method : element(METHOD) "the method to rename"
  param name : text "the new name" default "${name(method)}"
  let old = name(method)
  rename ${method} ${name}
  d := create METHOD ${owner(method)} ${old}
  set ${d} visibility ${attr(method, "visibility")}
  set ${d} static ${attr(method, "static")}
  set ${d} type ${type(method)}
  for p in params(method)
    q := create PARAM ${d} ${name(p)}
    set ${q} type ${type(p)}
  end
  create STATEMENT ${d} "" facts="body=return #{method}(#{params(d)})"
  return ${d}
end

refactoring introduce-constant "Moves an expression into a constant, a static final field the place reads, as IntelliJ's Introduce Constant"
  param method : element(METHOD) "the method the expression is in"
  param lines : lines "the expression's stretch"
  param name : text "name of the constant" default "VALUE"
  m := extract ${method} ${lines} ${concat("compute", name)}
  set ${m} static true
  f := create FIELD ${owner(method)} ${name}
  set ${f} visibility private
  set ${f} static true
  set ${f} final true
  set ${f} type ${type(m)}
  set ${f} initializer "#{m}()"
  for r in refs(m) | within method
    retarget ${r} ${f}
  end
  for r in refs(m) | within f
    inline ${r}
  end
  delete ${m}
  return ${f}
end

refactoring convert-to-instance-method "Makes a static method an instance method of a parameter's class, as IntelliJ's Convert to Instance Method"
  param method : element(METHOD) "the static method"
  param parameter : element(PARAM) "the parameter that becomes the object" from "params(method)"
  let to = declared-type(parameter)
  require nonempty(to) "${name(parameter)} is not of a class of the workspace"
  if ne(to, owner(method))
    move ${method} ${to}
  end
  set ${method} static false
  delete ${parameter} into=${to}
  return ${method}
end

refactoring make-field-instance "Makes a static field one each object has; its value is no longer shared, which matters when more than one object is made" changes meaning
  param field : element(FIELD) "the static field"
  require eq(attr(field, "static"), "true") "${name(field)} is not static"
  set ${field} static false
  return ${field}
end

refactoring introduce-parameter-object "Groups parameters of a method into a class it takes instead, as IntelliJ's Introduce Parameter Object"
  param method : element(METHOD) "the method"
  param params : elements(PARAM) "the parameters it groups" from "params(method)"
  param name : text "name of the class" default "${cap(name(method))}Parameters"
  param parameter : text "name of the parameter that takes them" default "parameters"
  c := create CLASS ${owner(top(method))} ${name}
  for p in params
    f := create FIELD ${c} ${name(p)}
    set ${f} type ${type(p)}
    set ${f} visibility private
    set ${f} final true
  end
  k := generate-constructor ${c} ${fields(c)}
  create PARAM ${method} ${parameter} facts="type=${name}" argument="new #{k}(#{params})"
  for p in params
    g := generate-getter ${first(fields(c) | named name(p))}
    for r in refs(p)
      retarget ${r} ${g}
    end
    delete ${p}
  end
  return ${c}
end

refactoring introduce-variable "Moves an expression into a local declared right before its statement, which reads it, as IntelliJ's Introduce Variable"
  param method : element(METHOD) "the method the expression is in"
  param lines : lines "the expression's stretch"
  param name : text "name of the local" default "value"
  m := extract ${method} ${lines} ${concat("compute", cap(name))}
  let at = statement(first(refs(m)))
  let passed = variables(method, params(m))
  v := create LOCAL ${method} ${name}
  set ${v} type ${type(m)}
  move ${first(statements(method))} ${owner(at)} before=${at}
  for r in refs(m)
    retarget ${r} ${v}
  end
  set ${v} initializer "#{m}(#{passed})"
  for r in refs(m)
    inline ${r}
  end
  delete ${m}
  return ${v}
end

refactoring introduce-local-object "Makes locals one object of an existing class, with one of its constructors, as Introduce Parameter Object does with parameters: each read of one reads the getter of the field the constructor gives it to; a parameter no local gives takes a value"
  param constructor : element(CONSTRUCTOR) "the constructor that makes the object"
  param locals : elements(LOCAL) "the locals, declared in the order the constructor takes them"
  param name : text "name of the object" default "${decap(name(owner(constructor)))}"
  param values : text "what the constructor's parameters no local gives take, as name = value, ..." default ""
  require nonempty(refs(locals)) "none of the locals is read"
  # before the first use of any of them: one may be read nowhere
  let at = statement(first(refs(locals)))
  # a value is a local of its own there, inlined with the others: named as its parameter, if no other is
  let made = list()
  for v in valued(values)
    l := create LOCAL ${owner(first(locals))} ${free-name(owner(first(locals)), v)} facts="type=${type(param-named(constructor, v))}"
    move ${first(statements(owner(first(locals))))} ${owner(at)} before=${at}
    set ${l} initializer ${value-of(values, v)}
    let made = list(made, l)
  end
  let all = in-order(constructor, locals, valued(values), made)
  o := create LOCAL ${owner(first(locals))} ${name} facts="type=${qualified(owner(constructor))}"
  move ${first(statements(owner(first(locals))))} ${owner(at)} before=${at}
  # the last first: a read made a getter's call on the object renumbers the uses after it
  for l in reversed(all)
    for r in reversed(refs(l))
      retarget ${r} ${getter-of(constructor, all, l)}
    end
  end
  set ${o} initializer "new #{constructor}(#{all})"
  # the last first: its value has nothing between it and the object's
  for l in reversed(all)
    inline-variable ${l}
  end
  return ${o}
end

refactoring move-statement "Moves a statement before another of its block, as IntelliJ's Move Statement Up and Down, only past statements it can run in either order with"
  param statement : element(STATEMENT) "the statement to move"
  param before : element(STATEMENT) "the statement of its block it goes before"
  for s in passed(statement, before)
    require empty(ordered(statement, s)) "${ordered(statement, s)}"
  end
  move ${statement} ${owner(before)} before=${before}
  return ${statement}
end

refactoring introduce-functional-parameter "Makes a method take what one of its calls does as an object of a new functional interface, as IntelliJ's Introduce Functional Parameter: the interface declares the called method, and the callers pass it"
  param method : element(METHOD) "the method that takes it"
  param called : element(METHOD) "the method it calls once, which its callers pass"
  param name : text "name of the new interface" default "${cap(name(called))}Function"
  param parameter : text "name of the parameter" default "function"
  let calls = refs(called) | within method
  require eq(count(calls), "1") "${qualified(method)} calls ${qualified(called)} other than once"
  i := create INTERFACE ${owner(top(method))} ${name}
  set ${i} annotations @FunctionalInterface
  let through = "this"
  if eq(attr(called, "static"), "true")
    let through = name(owner(called))
  end
  change-signature ${method} "${join(names(params(method)), ", ")}, ${name} ${parameter} = ${through}::${name(called)}"
  d := copy-signature ${called} ${i}
  # its uses are read anew: the call's, after the method's signature changed
  retarget ${first(refs(called) | within method)} ${d}
  return ${i}
end

refactoring move-out-of-loop "Moves the last statements of a loop's body after it: a local of the loop they read is declared before it and given its value in each turn; they run once, after the last turn, with what it left (its type's default if there was none)" changes meaning
  param from : element(STATEMENT) "the first statement to move: it and those after it in its block go"
  param locals : elements(LOCAL) "the locals of the loop they read"
  let loop = owner(from)
  let rest = after(from)
  let next = first(after(loop))
  for l in locals
    let named = name(l)
    out := create LOCAL ${owner(l)} ${concat(named, "Out")} facts="type=${type(l)}"
    set ${out} initializer default
    move ${first(statements(owner(l)))} ${owner(loop)} before=${loop}
    let at = statement(first(refs(l)))
    given := create STATEMENT ${loop} "" facts="body=#{out} = #{l}"
    move ${given} ${owner(at)} before=${at}
    for r in reversed(refs(l))
      if ne(statement(r), given)
        retarget ${r} ${out}
      end
    end
    inline-variable ${l}
    rename ${out} ${named}
  end
  move ${from} ${owner(loop)} before=${next}
  for s in rest
    move ${s} ${owner(loop)} before=${next}
  end
  return ${loop}
end

refactoring split-loop "Splits a loop in two, as Fowler's Split Loop: the first puts in a list the value each turn makes, the second does with each what came after it; it reads them all before doing anything" changes meaning
  param loop : element(STATEMENT) "the loop"
  param value : element(LOCAL) "what each turn makes, declared in the loop's block"
  param name : text "name of the list" default "values"
  let of = first(types-named(type(value)))
  require nonempty(of) "${type(value)} is no type a list can say"
  let start = statement(first(refs(value)))
  require eq(owner(start), loop) "${name(value)} is first read in no statement of the loop's own"
  let rest = after(start)
  list := create LOCAL ${owner(value)} ${name} facts="type=list of #{of}"
  set ${list} initializer "list of #{of}"
  move ${first(statements(owner(value)))} ${owner(loop)} before=${loop}
  each := create LOCAL ${owner(value)} ${concat(name(value), "In", cap(name))} facts="type=${type(value)}"
  # made in the loop first, so that what moves into it reads the value until it reads its own
  turn := create STATEMENT ${loop} "" facts="body=each #{each} in #{list}"
  move ${start} ${turn}
  for s in rest
    move ${s} ${turn}
  end
  for r in refs(value)
    retarget ${r} ${each}
  end
  move ${turn} ${owner(loop)} before=${first(after(loop))}
  create STATEMENT ${loop} "" facts="body=add #{value} to #{list}"
  rename ${each} ${name(value)}
  return ${list}
end

refactoring introduce-field "Moves an expression into a field that starts with it and that the place reads, as IntelliJ's Introduce Field"
  param method : element(METHOD) "the method the expression is in"
  param lines : lines "the expression's stretch"
  param name : text "name of the field" default "value"
  m := extract ${method} ${lines} ${concat("compute", cap(name))}
  f := create FIELD ${owner(method)} ${name}
  set ${f} visibility private
  set ${f} static ${attr(method, "static")}
  set ${f} final true
  set ${f} type ${type(m)}
  set ${f} initializer "#{m}()"
  for r in refs(m) | within method
    retarget ${r} ${f}
  end
  for r in refs(m) | within f
    inline ${r}
  end
  delete ${m}
  return ${f}
end
