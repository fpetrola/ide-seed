# The standard catalog: every refactoring here is a composition of primitives and other refactorings, or an intent:
# what is to hold at the end (want), in the knowledge's language, with nothing of how; the knowledge deduces the
# changes, and what they break. The coherence engine verifies and repairs the result, so scripts state intent, not care.
# No code of any language is written here: a body is said in the body language (#{x} names the element x), and each
# projection writes it in its own.

refactoring generate-getter "A public method getX that answers the value of a field x"
  param field : element(FIELD) "the field to read"
  getter := create METHOD ${owner(field)} get${cap(name(field))}
  set ${getter} visibility public
  set ${getter} static ${attr(field, "static")}
  set ${getter} type ${type(field)}
  create STATEMENT ${getter} "" facts="body=return #{field}"
  return ${getter}
end

refactoring generate-setter "A public method setX(x) that gives a field x a value"
  param field : element(FIELD) "the field to write"
  setter := create METHOD ${owner(field)} set${cap(name(field))}
  set ${setter} visibility public
  set ${setter} static ${attr(field, "static")}
  p := create PARAM ${setter} ${name(field)}
  set ${p} type ${type(field)}
  create STATEMENT ${setter} "" facts="body=#{field} = #{p}"
  return ${setter}
end

refactoring encapsulate-field "Accessors for a field; uses outside its type go through them; the field becomes private"
  param field : element(FIELD) "the field to encapsulate"
  getter := generate-getter ${field}
  setter := generate-setter ${field}
  for r in refs(field) | not-within top(field)
    if eq(mode(r), "read")
      retarget ${r} ${getter}
    else
      retarget ${r} ${setter}
    end
  end
  set ${field} visibility private
  return ${field}
end

intent pull-up-field "Moves a field to the superclass of its type"
  param field : element(FIELD) "the field to move up"
  want given parent(field, t) and given superclass(t, u) and parent(field, u)
end

refactoring pull-up-method "Moves a method to the superclass of its type"
  param method : element(METHOD) "the method to move up"
  require nonempty(superclass(owner(method))) "${qualified(owner(method))} has no superclass"
  move ${method} ${superclass(owner(method))}
  return ${method}
end

refactoring extract-superclass "Creates a class between a type and its superclass and pulls fields up into it"
  param type : element(CLASS) "the type to extract from"
  param name : text "name of the new superclass" default "Abstract${name(type)}"
  param fields : elements(FIELD) "fields to pull up" from "fields(type)"
  base := create CLASS ${owner(type)} ${name}
  if nonempty(attr(type, "superclass"))
    set ${base} superclass ${attr(type, "superclass")}
  end
  link ${type} extends ${base}
  for f in fields
    pull-up-field ${f}
  end
  return ${base}
end

refactoring rename-method-family "Renames a method with every method it overrides or that overrides it"
  param method : element(METHOD) "any method of the family"
  param name : text "the new name" default "${name(method)}"
  for m in family(method)
    rename ${m} ${name}
  end
  return ${method}
end

refactoring move-type "Moves a top-level type to another package"
  param type : element(CLASS,INTERFACE) "the type to move"
  param package : element(PACKAGE) "the destination package"
  move ${type} ${package}
  return ${type}
end

refactoring safe-delete "Deletes an element if nothing uses it"
  param element : element(FIELD,METHOD) "what to delete"
  delete ${element}
end

refactoring introduce-factory "Static factory for a constructor; every new outside it goes through the factory"
  param constructor : element(CONSTRUCTOR) "the constructor to hide"
  param name : text "name of the factory method" default "create${name(owner(constructor))}"
  f := create METHOD ${owner(constructor)} ${name}
  set ${f} visibility public
  set ${f} static true
  set ${f} type ${name(owner(constructor))}
  for p in params(constructor)
    q := create PARAM ${f} ${name(p)}
    set ${q} type ${type(p)}
  end
  create STATEMENT ${f} "" facts="body=return new #{constructor}(#{params(f)})"
  for r in refs(constructor) | not-within f
    retarget ${r} ${f}
  end
  set ${constructor} visibility private
  return ${f}
end

refactoring encapsulate-fields "Encapsulates every public field of a type, skipping the ones that cannot be"
  param type : element(CLASS) "the type whose public fields to encapsulate"
  for f in fields(type) | with-attr "visibility=public"
    try "${qualified(f)}"
      encapsulate-field ${f}
    end
  end
  return ${type}
end

refactoring copy-signature "Declares a method's signature, without a body, in another type"
  param method : element(METHOD) "the method whose signature to copy"
  param into : element(CLASS,INTERFACE) "where to declare it"
  d := create METHOD ${into} ${name(method)}
  set ${d} type ${type(method)}
  for p in params(method)
    q := create PARAM ${d} ${name(p)}
    set ${q} type ${type(p)}
  end
  if eq(kind(into), "CLASS")
    set ${d} visibility ${attr(method, "visibility")}
  end
  set ${d} abstract true
  return ${d}
end

refactoring declare-abstract-in-superclass "Declares a method abstract in the superclass of its type"
  param method : element(METHOD) "the method to declare"
  require nonempty(superclass(owner(method))) "${qualified(owner(method))} has no superclass"
  copy-signature ${method} ${superclass(owner(method))}
  set ${superclass(owner(method))} abstract true
  return ${method}
end

refactoring extract-interface "Creates an interface with some methods of a type, and the type implements it"
  param type : element(CLASS) "the type to extract from"
  param name : text "name of the new interface" default "I${name(type)}"
  param methods : elements(METHOD) "the methods the interface declares" from "methods(type)"
  i := create INTERFACE ${owner(type)} ${name}
  for m in methods
    copy-signature ${m} ${i}
  end
  link ${type} implements ${i}
  return ${i}
end

refactoring rename-field-with-accessors "Renames a field together with its getter and setter, if it has them"
  param field : element(FIELD) "the field to rename"
  param name : text "the new name" default "${name(field)}"
  let getter = first(methods(owner(field)) | named concat("get", cap(name(field))))
  let setter = first(methods(owner(field)) | named concat("set", cap(name(field))))
  rename ${field} ${name}
  if nonempty(getter)
    rename ${getter} get${cap(name)}
  end
  if nonempty(setter)
    rename ${setter} set${cap(name)}
  end
  return ${field}
end

refactoring inline-method "Replaces every call of a method by its body, then deletes it"
  param method : element(METHOD) "a method whose body is a single return"
  # the last first: inlining a use renumbers the uses after it in its method
  for r in reversed(refs(method))
    inline ${r}
  end
  delete ${method}
end

refactoring inline-variable "Replaces every read of a local by the value it is given, then deletes it"
  param local : element(LOCAL) "a local given its value where it is declared, and never again"
  # the last first: inlining a use renumbers the uses after it in its method
  for r in reversed(refs(local))
    inline ${r}
  end
  delete ${local}
end

refactoring extract-method "Moves a run of statements into a new private method and calls it"
  param method : element(METHOD) "the method the statements are in"
  param lines : lines "first-last line of the statements"
  param name : text "name of the new method" default "extracted"
  m := extract ${method} ${lines} ${name}
  return ${m}
end

refactoring push-down-member "Moves a member into the only subclass of its type"
  param member : element(FIELD,METHOD) "the member to push down"
  let subs = subclasses(owner(member))
  require eq(count(subs), 1) "${qualified(owner(member))} must have exactly one subclass"
  move ${member} ${first(subs)}
  return ${member}
end

refactoring pull-up-unifying "Moves a member up to its superclass; the same member in the other subclasses goes into it"
  param member : element(FIELD,METHOD) "the member to move up"
  let sup = superclass(owner(member))
  require nonempty(sup) "${qualified(owner(member))} has no superclass in the workspace"
  move ${member} ${sup}
  for s in subclasses(sup)
    let twin = member-named(s, member)
    if nonempty(twin)
      if and(eq(type(twin), type(member)), eq(body(twin), body(member)), eq(attr(twin, "static"), attr(member, "static")))
        delete ${twin} into=${member}
      end
    end
  end
  return ${member}
end

refactoring collapse-hierarchy "Merges a class into its superclass: its members go up and its uses use the superclass"
  param type : element(CLASS) "the class to merge away"
  let sup = superclass(type)
  require nonempty(sup) "${qualified(type)} has no superclass in the workspace"
  require empty(constructors(type)) "${qualified(type)} has constructors; ${qualified(sup)} has no equivalent"
  for m in members(type)
    move ${m} ${sup}
  end
  for r in refs(type)
    retarget ${r} ${sup}
  end
  delete ${type}
end

refactoring redirect-uses "Points every use of an element at another of the same kind"
  param from : element(FIELD,METHOD) "the element whose uses move"
  param to : element(FIELD,METHOD) "the element they use instead"
  for r in refs(from)
    retarget ${r} ${to}
  end
  return ${to}
end

refactoring merge-duplicate "Keeps one of two methods with the same body: uses of the other go to it, the other goes"
  param keep : element(METHOD) "the method to keep"
  param duplicate : element(METHOD) "the method to drop"
  require eq(body(keep), body(duplicate)) "${qualified(keep)} and ${qualified(duplicate)} have different bodies"
  delete ${duplicate} into=${keep}
  return ${keep}
end

refactoring generalize-declared-type "Declares a field or parameter with one of its supertypes"
  param element : element(FIELD,PARAM) "the field or parameter"
  param type : element(CLASS,INTERFACE) "the supertype to declare it with"
  link ${element} declared ${type}
  return ${element}
end

refactoring rename-package "Moves every type of a package to a new package"
  param package : element(PACKAGE) "the package to rename"
  param name : text "the new qualified name" default "${qualified(package)}"
  p := create PACKAGE name=${name}
  for t in types-of(package)
    move-type ${t} ${p}
  end
  return ${p}
end

refactoring generate-constructor "A constructor that takes a value for each field given, and assigns it"
  param type : element(CLASS) "the class"
  param fields : elements(FIELD) "the fields it sets" from "fields(type)"
  c := create CONSTRUCTOR ${type} ${name(type)}
  set ${c} visibility public
  for f in fields
    p := create PARAM ${c} ${name(f)}
    set ${p} type ${type(f)}
    create STATEMENT ${c} "" facts="body=#{f} = #{p}"
  end
  return ${c}
end

refactoring make-final "Makes a field final: nothing may assign it but where it is declared or a constructor"
  param field : element(FIELD) "the field"
  set ${field} final true
  return ${field}
end

refactoring make-static "Makes a method static: it may use nothing of an object"
  param method : element(METHOD) "the method"
  set ${method} static true
  return ${method}
end

refactoring generate-delegates "Methods that hand each call on to what a field holds, as IntelliJ's Delegate Methods"
  param field : element(FIELD) "the field that does the work"
  param methods : elements(METHOD) "the methods to hand on" from "methods(declared-type(field))"
  for m in methods
    d := create METHOD ${owner(field)} ${name(m)}
    set ${d} visibility public
    set ${d} type ${type(m)}
    for p in params(m)
      q := create PARAM ${d} ${name(p)}
      set ${q} type ${type(p)}
    end
    create STATEMENT ${d} "" facts="body=return #{field}.#{m}(#{params(d)})"
  end
  return ${field}
end

refactoring rename-with-delegate "Renames a method and keeps its old name as a method that calls the new one, for who still calls it"
  param method : element(METHOD) "the method to rename"
  param name : text "the new name" default "${name(method)}"
  let old = name(method)
  rename ${method} ${name}
  d := create METHOD ${owner(method)} ${old}
  set ${d} visibility ${attr(method, "visibility")}
  set ${d} static ${attr(method, "static")}
  set ${d} type ${type(method)}
  for p in params(method)
    q := create PARAM ${d} ${name(p)}
    set ${q} type ${type(p)}
  end
  create STATEMENT ${d} "" facts="body=return #{method}(#{params(d)})"
  return ${d}
end

refactoring introduce-constant "Moves an expression into a constant, a static final field the place reads, as IntelliJ's Introduce Constant"
  param method : element(METHOD) "the method the expression is in"
  param lines : lines "the expression's stretch"
  param name : text "name of the constant" default "VALUE"
  m := extract ${method} ${lines} ${concat("compute", name)}
  set ${m} static true
  f := create FIELD ${owner(method)} ${name}
  set ${f} visibility private
  set ${f} static true
  set ${f} final true
  set ${f} type ${type(m)}
  set ${f} initializer "#{m}()"
  for r in refs(m) | within method
    retarget ${r} ${f}
  end
  for r in refs(m) | within f
    inline ${r}
  end
  delete ${m}
  return ${f}
end

refactoring introduce-field "Moves an expression into a field that starts with it and that the place reads, as IntelliJ's Introduce Field"
  param method : element(METHOD) "the method the expression is in"
  param lines : lines "the expression's stretch"
  param name : text "name of the field" default "value"
  m := extract ${method} ${lines} ${concat("compute", cap(name))}
  f := create FIELD ${owner(method)} ${name}
  set ${f} visibility private
  set ${f} static ${attr(method, "static")}
  set ${f} final true
  set ${f} type ${type(m)}
  set ${f} initializer "#{m}()"
  for r in refs(m) | within method
    retarget ${r} ${f}
  end
  for r in refs(m) | within f
    inline ${r}
  end
  delete ${m}
  return ${f}
end
