# How Java is: definitions the planner makes true by changing what they look at (decision 32, phase 0). Nothing
# here is a fix or a step of a refactoring.
# A definition is read left to right: a relation of the graph, asked with what is known, binds the rest; one whose
# arguments are all known and that does not hold is made to hold, by the primitive that changes it (a visibility is
# set, a member moved, a use bound, a constructor created). The definitions written first are the ways tried first.
# The graph's relations: kind, name, parent, visibility, top-level, top, package, enclosing, subclass, overrides,
# alike, before, constructor, named, unresolved, site, target, and known (what came with the problem).

order visibility "private" "package" "protected" "public"

# A top-level type is package-private or public; anything else may have any visibility.
def may-be(e, v) when visibility(e, _) and visibility-value(v) and not top-level(e)
def may-be(e, "package") when top-level(e)
def may-be(e, "public") when top-level(e)

# Who can use what (JLS 6.6), from the narrowest visibility that lets the site use it.
def accessible(site, m) when top(site, t) and top(m, t)
  and may-be(m, "private") and visibility(m, "private")
def accessible(site, m) when package(site, p) and package(m, p)
  and may-be(m, "package") and visibility(m, "package")
def accessible(site, m) when protected-reach(site, m)
  and may-be(m, "protected") and visibility(m, "protected")
def accessible(site, m) when kind(site, _)
  and may-be(m, "public") and visibility(m, "public")

def protected-reach(site, m) when package(site, p) and package(m, p)
def protected-reach(site, m) when enclosing(site, a) and enclosing(m, b) and subclass(a, b)

say visibility for accessible "open-visibility ${qualified(element)} ${was} -> ${value}"

# Where a member is used without saying whose (JLS 8.2): in its type and in the types that inherit it. It can live in
# a class both where it was and where it is used inherit from: what had it keeps it.
def in-scope(site, m) when not kind(site, "field") and enclosing(site, t) and parent(m, o)
  and subclass(o, u) and subclass(t, u) and not clash(m, u) and parent(m, u)
# A field's initializer uses a field of its own type only if it is declared before (JLS 8.3.3).
def in-scope(site, m) when kind(site, "field") and parent(site, t) and parent(m, o)
  and subclass(o, t) and not clash(m, t) and parent(m, t) and before(m, site)

# Two members alike in one type are one too many.
def clash(m, u) when parent(x, u) and alike(x, m) and x != m

say parent for in-scope "pull-up-dependency ${qualified(element)} -> ${qualified(value)}"

# An override is at least as visible as what it overrides (JLS 8.4.8.3).
def visible-as-overridden(m) when overrides(m, n) and visibility(n, vn)
  and visibility-at-least(v, vn) and may-be(m, v) and visibility(m, v)

say visibility for visible-as-overridden "make ${name(element)}() ${value}"

# A type written in a file names a type of that name that the file can use (JLS 6.5.5): binding the use to it is
# what importing it does.
def resolves(symbol) when known("path", path) and unresolved(u, path, symbol, "type")
  and named(t, symbol) and site(u, s) and top(s, here) and accessible(here, t) and target(u, t)

say target for resolves "import ${qualified(value)}"

# A class or an enum that declares no constructor has one with no parameters (JLS 8.8.9, 8.9.2): writing it changes
# nothing, and then the type declares one.
def constructed-explicitly(t) when kind(t, "class") and constructor(k, t)
def constructed-explicitly(t) when kind(t, "enum") and constructor(k, t)

say constructor for constructed-explicitly "create constructor ${name(value)}()"

# What needs an object (JLS 8.4.3.2, 15.12.3): a static method or field uses an instance member of its own object
# only through an object, and what is used through a type is static.
rule no-object "a static member uses an instance member of its own object only through an object"
  for s, m where self-use(s, m) and not static(m)
  must not static(s)
end

rule through-type "what is used through a type is static"
  for s, m where type-use(s, m)
  must static(m)
end

# A field's static says how many values it has: one for all objects, or one for each.
promise static of field "one value for all objects, or one for each"

problem ecj.StaticMethodRequested is no-object(inside(path, line, column), element-at(path, line, column))
problem ecj.NonStaticFieldFromStaticInvocation is no-object(inside(path, line, column), element-at(path, line, column))

say static for no-object "make ${called} static"
say not static for no-object "make ${called} not static"
say static for through-type "make ${called} static"
say not static for through-type "make ${called} not static"

# Who gives a final field its value (JLS 8.3.1.2, 16): its own type's constructors and initializers, an initializer
# being read as the type itself.
def may-assign(s, f) when kind(s, "constructor") and parent(s, t) and parent(f, t)
def may-assign(s, f) when parent(f, s) and kind(f, "field")

rule final-where "a final field is given its value only by its own type's constructors and initializers"
  for s, f where writes(s, f) and final(f)
  must may-assign(s, f)
end

# A final field's value never changes once the object is made.
promise final of field "the value never changes once the object is made"

problem ecj.FinalFieldAssignment is final-where(inside(path, line, column), element-at(path, line, column))

say not final for final-where "make ${called} not final"

# A class that is not abstract implements every method it inherits without a body (JLS 8.1.1.1), and nothing makes
# an object of one that is (JLS 15.9.1).
rule complete "a class that is not abstract implements every method it inherits without a body"
  for t where kind(t, "class") and unimplemented(t, m)
  must abstract(t)
end

rule no-new-abstract "nothing makes an object of an abstract class"
  for s, k where new-use(s, k) and parent(k, t)
  must not abstract(t)
end

# Whether objects of a class can be made.
promise abstract of class "whether objects of it can be made"

problem ecj.AbstractMethodMustBeImplemented is complete(type-in(path, symbol))

say abstract for complete "make ${called} abstract"
say not unimplemented for complete "implement methods of ${called}"

# What a method answers, or a field starts with, is of the type it declares (JLS 14.17, 8.3.2): the compiler says of
# what type the value is (its first argument).
def answers-its-type(m) when kind(m, "method") and argument("0", t) and type(m, t)
def starts-as-its-type(f) when kind(f, "field") and argument("0", t) and type(f, t)

goal ecj.ReturnTypeMismatch needs answers-its-type(inside(path, line, column))
goal ecj.TypeMismatch needs answers-its-type(inside(path, line, column))
goal ecj.TypeMismatch needs starts-as-its-type(inside(path, line, column))

# A type is part of how a member is used.
promise type of method "what it answers is part of how it is called"
promise type of field "what it holds is part of how it is used"

say type for answers-its-type "change return type of ${called} to ${value}"
say type for starts-as-its-type "change type of ${called} to ${value}"

# A final field not given its value where it is declared gets it from each constructor of its type that does not
# hand the work to another with this(...), or from an initializer of its type; a class that declares no constructor
# has the language's, which gives nothing (JLS 8.3.1.2, 16.9). The violation is the field's, whichever constructor
# misses it: declaring the language's constructor does not make it a new one.
def delegates(k) when self-use(k, c) and kind(c, "constructor") and parent(c, t) and parent(k, t)
def declares-constructor(t) when constructor(_, t)
def builds(k, t) when constructor(k, t) and not delegates(k)
def builds(t, t) when kind(t, "class") and not declares-constructor(t)
def given-by(k, f) when writes(k, f)
def given-by(k, f) when builds(k, t) and parent(f, t) and writes(t, f)

rule final-once "a final field is given its value where it is declared, or by each constructor of its type"
  for f where final(f) and not initialized(f) and parent(f, t) and builds(k, t)
  must given-by(k, f)
end

problem ecj.UninitializedBlankFinalField is final-once(field-in(path, first(arguments)))

say not final for final-once "make ${called} not final"
say initialized for final-once "initialize ${called} in its declaration"

# What a field starts with, where it is declared, is the person's to say: the language's start for its type proposed.
def start-of(f, v) when type(f, t) and start-value(t, v)
ask value "initial value" for initialized of field default start-of

# A name used as a value (JLS 6.5.6.1) is a field of the type it is looked up in, of the type its place expects; or,
# used inside a method, one of its parameters, which every call passes what that type starts with.
def resolves(symbol) when known("path", path) and unresolved(u, path, symbol, "value") and scope(u, t)
  and not library(t) and expected(u, ty) and member(f, t, symbol, "field") and type(f, ty)
def resolves(symbol) when known("path", path) and unresolved(u, path, symbol, "value") and site(u, m)
  and kind(m, "method") and expected(u, ty) and start-value(ty, v) and parameter(p, m, symbol, v) and type(p, ty)

say member for resolves "create ${kind} ${named} in ${name(owner)}"
say parameter for resolves "create parameter ${named} in ${name(owner)}()"

# A name misspelled (JLS 6.5.6.1, 15.12.1): a member the type it is looked up in has whose name is almost it, one or
# two letters away as a typo is, the nearest first; changing the use to it writes its name.
def resolves(symbol) when known("path", path) and unresolved(u, path, symbol, "value") and scope(u, t)
  and similar(f, t, symbol, "field") and site(u, s) and accessible(s, f) and spelled(u, f)
def resolves(symbol) when known("path", path) and unresolved(u, path, symbol, "call") and scope(u, t)
  and similar(m, t, symbol, "method") and site(u, s) and accessible(s, m) and called-as(u, m)

def spelled(u, f) when target(u, f)
def called-as(u, m) when target(u, m)

say target for spelled "change to ${name(value)}"
say target for called-as "change to ${name(value)}(..)"

# A private member nothing uses (JLS 6.6.1: nothing outside its type can): it is used, or it is not there.
def used-or-gone(symbol) when known("path", path) and declared(e, path, symbol) and visibility(e, "private") and not exists(e)

say not exists for used-or-gone "remove ${name(element)}"

# What only the person knows of what is created: asked, with what the rules deduce proposed.
ask type "type of the new field" for type of new field

# A name called (JLS 15.12) is a method of the type it is looked up in: answering what the call's place expects,
# taking a parameter for each argument the call passes; static when called from a static place of its own type.
def resolves(symbol) when known("path", path) and unresolved(u, path, symbol, "call") and scope(u, t)
  and not library(t) and expected(u, ty) and member(m, t, symbol, "method") and type(m, ty)
  and takes-arguments(m, u) and fits-call(m, u)

def fits-call(m, u) when site(u, s) and given static(s) and enclosing(s, t) and scope(u, t) and static(m)
def fits-call(m, u) when site(u, s) and given not static(s) and kind(m, _)
def fits-call(m, u) when site(u, s) and given static(s) and enclosing(s, e) and scope(u, t) and e != t and kind(m, _)

ask type "return type of the new method" for type of new method

# A new object that no constructor makes (JLS 15.9.3): its class gets one that takes what the new passes.
def constructs(symbol) when known("path", path) and unresolved(u, path, symbol, "new") and scope(u, t)
  and not library(t) and constructor-for(k, t, u) and takes-arguments(k, u)

say constructor-for for constructs "create constructor in ${name(owner)}"

# A type written that no type of the program is (JLS 6.5.5): the file's package declares one, a class or an interface.
def resolves(symbol) when known("path", path) and unresolved(u, path, symbol, "type") and not named(_, symbol)
  and site(u, s) and top(s, h) and parent(h, p) and member(c, p, symbol, "class")
def resolves(symbol) when known("path", path) and unresolved(u, path, symbol, "type") and not named(_, symbol)
  and site(u, s) and top(s, h) and parent(h, p) and member(c, p, symbol, "interface")
