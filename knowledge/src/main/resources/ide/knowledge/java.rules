# How Java is: definitions the planner makes true by changing what they look at (decision 32, phase 0). Nothing
# here is a fix or a step of a refactoring.
# A definition is read left to right: a relation of the graph, asked with what is known, binds the rest; one whose
# arguments are all known and that does not hold is made to hold, by the primitive that changes it (a visibility is
# set, a member moved, a use bound, a constructor created). The definitions written first are the ways tried first.
# The graph's relations: kind, name, parent, visibility, top-level, top, package, enclosing, subclass, overrides,
# alike, before, constructor, named, unresolved, site, target, and known (what came with the problem).

order visibility "private" "package" "protected" "public"

# A top-level type is package-private or public; anything else may have any visibility.
def may-be(e, v) when visibility(e, _) and visibility-value(v) and not top-level(e)
def may-be(e, "package") when top-level(e)
def may-be(e, "public") when top-level(e)

# Who can use what (JLS 6.6), from the narrowest visibility that lets the site use it.
def accessible(site, m) when top(site, t) and top(m, t)
  and may-be(m, "private") and visibility(m, "private")
def accessible(site, m) when package(site, p) and package(m, p)
  and may-be(m, "package") and visibility(m, "package")
def accessible(site, m) when protected-reach(site, m)
  and may-be(m, "protected") and visibility(m, "protected")
def accessible(site, m) when kind(site, _)
  and may-be(m, "public") and visibility(m, "public")

def protected-reach(site, m) when package(site, p) and package(m, p)
def protected-reach(site, m) when enclosing(site, a) and enclosing(m, b) and subclass(a, b)

say visibility for accessible "open-visibility ${qualified(element)} ${was} -> ${value}"

# Where a member is used without saying whose (JLS 8.2): in its type and in the types that inherit it. It can live in
# a class both where it was and where it is used inherit from: what had it keeps it.
def in-scope(site, m) when not kind(site, "field") and enclosing(site, t) and parent(m, o)
  and subclass(o, u) and subclass(t, u) and not clash(m, u) and parent(m, u)
# A field's initializer uses a field of its own type only if it is declared before (JLS 8.3.3).
def in-scope(site, m) when kind(site, "field") and parent(site, t) and parent(m, o)
  and subclass(o, t) and not clash(m, t) and parent(m, t) and before(m, site)

# Two members alike in one type are one too many.
def clash(m, u) when parent(x, u) and alike(x, m) and x != m

say parent for in-scope "pull-up-dependency ${qualified(element)} -> ${qualified(value)}"
