# What must hold for each violation or diagnostic to go away, when a predicate holds, and what makes it hold.
# No remedy is written in Java: repairs and quick fixes are deduced from here, and the verifier judges them.
# What an effect needs holds already or is made first, deduced backward the same way.

goal access.insufficient needs accessible(site, target)
goal binding.unresolved needs in-scope(site, target)
goal javac.cant.resolve.location needs resolves(symbol)
goal javac.cant.resolve needs resolves(symbol)
goal javac.cant.resolve.location.args needs resolves(symbol)

fact accessible(site, target) when can-access(site, target)

effect open-visibility "open-visibility ${qualified(target)} ${attr(target, "visibility")} -> ${v}"
  makes accessible(site, target)
  for v in wider(target)
  do
    set ${target} visibility ${v}
  end
end

effect pull-up-dependency "pull-up-dependency ${qualified(target)} -> ${qualified(enclosing(site))}"
  makes in-scope(site, target)
  when and(ne(owner(target), enclosing(site)), subclass-of(owner(target), enclosing(site)), empty(member-named(enclosing(site), target)))
  do
    if eq(kind(site), "FIELD")
      move ${target} ${enclosing(site)} ${site}
    else
      move ${target} ${enclosing(site)}
    end
  end
end

effect import "import ${qualified(t)}"
  makes resolves(symbol)
  when nonempty(unresolved-in(path, symbol, "type"))
  for t in types-named(symbol)
  needs accessible(top-in(path), t)
  do
    retarget ${unresolved-in(path, symbol, "type")} ${t}
  end
end

# A name misspelled: the members of the type it is looked up in whose names are almost it.
effect use-similar "change to ${name(f)}"
  makes resolves(symbol)
  when nonempty(unresolved-in(path, symbol, "value"))
  for f in similar(scope(unresolved-in(path, symbol, "value")), symbol, "FIELD")
  needs accessible(site(unresolved-in(path, symbol, "value")), f)
  do
    retarget ${unresolved-in(path, symbol, "value")} ${f}
  end
end

effect call-similar "change to ${name(m)}(..)"
  makes resolves(symbol)
  when nonempty(unresolved-in(path, symbol, "call"))
  for m in similar(scope(unresolved-in(path, symbol, "call")), symbol, "METHOD")
  needs accessible(site(unresolved-in(path, symbol, "call")), m)
  do
    retarget ${unresolved-in(path, symbol, "call")} ${m}
  end
end

effect create-field "create field ${symbol} in ${name(scope(unresolved-in(path, symbol, "value")))}"
  makes resolves(symbol)
  when nonempty(scope(unresolved-in(path, symbol, "value")))
  ask type "type of the new field" "int"
  cost 2
  do
    f := create FIELD ${scope(unresolved-in(path, symbol, "value"))} ${symbol}
    set ${f} type ${type}
  end
end

goal javac.var.not.initialized.in.default.constructor needs initialized(symbol)

effect initialize-in-declaration "initialize ${symbol} in its declaration"
  makes initialized(symbol)
  ask value "initial value" "${default-value(type(field-in(path, symbol)))}"
  do
    set ${field-in(path, symbol)} initializer ${value}
  end
end

effect drop-final "make ${symbol} not final"
  makes initialized(symbol)
  cost 2
  do
    set ${field-in(path, symbol)} final false
  end
end
