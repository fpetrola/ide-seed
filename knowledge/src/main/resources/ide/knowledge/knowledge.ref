# What must hold for each violation or diagnostic to go away, when a predicate holds, and what makes it hold.
# No remedy is written in Java: repairs and quick fixes are deduced from here, and the verifier judges them.
# What an effect needs holds already or is made first, deduced backward the same way.
# How Java is lives in java.rules: what its definitions ask for (something opened, moved where it is used, imported,
# declared as the language would) is deduced, and keeps meaning. An effect here is a quick fix people choose; only one
# that "keeps meaning" may also repair a refactoring by itself: a name changed to a similar one, a value made up, a
# final dropped are never done behind anybody's back.

goal access.insufficient needs accessible(site, target)
goal binding.unresolved needs in-scope(site, target)
# What Eclipse's compiler says does not resolve: a type, a variable or a field, a method.
goal ecj.UndefinedType needs resolves(symbol)
goal ecj.UndefinedName needs resolves(symbol)
goal ecj.UnresolvedVariable needs resolves(symbol)
goal ecj.UndefinedField needs resolves(symbol)
goal ecj.UndefinedMethod needs resolves(symbol)

# accessible(site, target): how Java says who can use what is in java.rules, and the planner makes it hold from there.

# in-scope(site, target): where a member can be used without saying whose is in java.rules.

# resolves(symbol) by a type of that name: java.rules says it, and binding the use imports it.

# A name misspelled: the members of the type it is looked up in whose names are almost it.
effect use-similar "change to ${name(f)}"
  makes resolves(symbol)
  when nonempty(unresolved-in(path, symbol, "value"))
  for f in similar(scope(unresolved-in(path, symbol, "value")), symbol, "FIELD")
  needs accessible(site(unresolved-in(path, symbol, "value")), f)
  do
    retarget ${unresolved-in(path, symbol, "value")} ${f}
  end
end

effect call-similar "change to ${name(m)}(..)"
  makes resolves(symbol)
  when nonempty(unresolved-in(path, symbol, "call"))
  for m in similar(scope(unresolved-in(path, symbol, "call")), symbol, "METHOD")
  needs accessible(site(unresolved-in(path, symbol, "call")), m)
  do
    retarget ${unresolved-in(path, symbol, "call")} ${m}
  end
end

effect create-field "create field ${symbol} in ${name(scope(unresolved-in(path, symbol, "value")))}"
  makes resolves(symbol)
  when nonempty(scope(unresolved-in(path, symbol, "value")))
  ask type "type of the new field" "${expected(unresolved-in(path, symbol, "value"))}"
  cost 2
  do
    f := create FIELD ${scope(unresolved-in(path, symbol, "value"))} ${symbol}
    set ${f} type ${type}
  end
end

# A call to no method: the method, where the call looks for it, taking what the call passes; static if it is called
# from a static place of its own type, and answering what its type starts with until it is written.
effect create-method "create method ${symbol} in ${name(scope(unresolved-in(path, symbol, "call")))}"
  makes resolves(symbol)
  when nonempty(scope(unresolved-in(path, symbol, "call")))
  ask type "return type of the new method" "${expected(unresolved-in(path, symbol, "call"))}"
  cost 2
  do
    let call = unresolved-in(path, symbol, "call")
    let where = scope(call)
    let alone = and(eq(where, enclosing(site(call))), eq(attr(site(call), "static"), "true"))
    let passed = arguments(call)
    m := create METHOD ${where} ${symbol}
    set ${m} static ${alone}
    set ${m} type ${type}
    for a in passed
      p := create PARAM ${m} ${first(a)}
      set ${p} type ${last(a)}
    end
    set ${m} body "return default"
  end
end

# A blank final field has its value where it is declared or from every constructor of its type; Eclipse says so at
# the field, or at a constructor that does not give it one, naming the field.
goal ecj.UninitializedBlankFinalField needs given-a-value(first(arguments))

effect initialize-in-declaration "initialize ${field} in its declaration"
  makes given-a-value(field)
  ask value "initial value" "${default-value(type(field-in(path, field)))}"
  do
    set ${field-in(path, field)} initializer ${value}
  end
end

# Every constructor takes the value, and the calls pass what its type starts with. A type that declares no
# constructor has the one the language gives, which assigns nothing: one is declared first (java.rules says how).
effect initialize-in-constructors "initialize ${field} in the constructors"
  makes given-a-value(field)
  needs constructed-explicitly(owner(field-in(path, field)))
  cost 2
  do
    let f = field-in(path, field)
    for c in constructors(owner(f))
      p := create PARAM ${c} ${field} argument=${default-value(type(f))}
      set ${p} type ${type(f)}
      set ${c} body "...; ${said(f)} = ${said(p)}"
    end
  end
end

# A constructor may not give a final field of its superclass its value: the superclass's constructor takes the value
# and gives it, and the constructor passes it to that constructor first, instead of giving it. The field gets the
# same value when the object is made: it keeps meaning, so it also repairs a refactoring (a field pulled up).
goal ecj.FinalFieldAssignment needs given-by-its-type(element-at(path, line, column), inside(path, line, column))

effect pass-to-superclass "pass ${name(field)} to the constructor of ${name(owner(field))}"
  makes given-by-its-type(field, constructor)
  keeps meaning
  when and(eq(kind(constructor), "CONSTRUCTOR"), nonempty(value-given(constructor, field)))
  needs constructed-explicitly(owner(field))
  do
    let made = first(constructors(owner(field)))
    let value = value-given(constructor, field)
    let rest = said-without(constructor, field)
    p := create PARAM ${made} ${name(field)}
    set ${p} type ${type(field)}
    set ${made} body "...; ${said(field)} = ${said(p)}"
    set ${constructor} body "${said(made)}(${value}); ${rest}"
  end
end

# A class that does not implement what its supertypes leave abstract: it implements each, answering what the type
# starts with until it is written; or it is abstract too (java.rules says when it may be).
goal ecj.AbstractMethodMustBeImplemented needs complete(symbol)

effect implement-methods "implement methods of ${symbol}"
  makes complete(symbol)
  when nonempty(unimplemented(type-in(path, symbol)))
  do
    let t = type-in(path, symbol)
    for m in unimplemented(t)
      d := create METHOD ${t} ${name(m)}
      set ${d} visibility ${attr(m, "visibility")}
      set ${d} type ${type(m)}
      for p in params(m)
        q := create PARAM ${d} ${name(p)}
        set ${q} type ${type(p)}
      end
      set ${d} body "return default"
    end
  end
end

# A method used from a static place, where there is no object to call it on: java.rules says what needs an object.

# A private member nothing uses: it goes.
goal ecj.UnusedPrivateField needs used-or-gone(symbol)
goal ecj.UnusedPrivateMethod needs used-or-gone(symbol)

effect remove-unused "remove ${name(e)}"
  makes used-or-gone(symbol)
  for e in members-in(path, symbol)
  do
    delete ${e}
  end
end

# What a file cannot see: the member or type the name at the problem binds.
goal ecj.NotVisibleMethod needs accessible(top-in(path), element-at(path, line, column))
goal ecj.NotVisibleField needs accessible(top-in(path), element-at(path, line, column))
goal ecj.NotVisibleConstructor needs accessible(top-in(path), element-at(path, line, column))
goal ecj.NotVisibleType needs accessible(top-in(path), element-at(path, line, column))

# A value of another type than its place takes: java.rules says the place takes the value's type.

# A name nothing declares, used inside a method: the method takes it, of the type its place expects; its calls pass
# what that type starts with.
effect create-parameter "create parameter ${symbol} in ${name(m)}()"
  makes resolves(symbol)
  for m in inside(path, line, column) | of-kind "METHOD"
  when nonempty(unresolved-in(path, symbol, "value"))
  cost 3
  do
    let t = expected(unresolved-in(path, symbol, "value"))
    p := create PARAM ${m} ${symbol} argument=${default-value(t)}
    set ${p} type ${t}
  end
end

# A method that says it overrides and overrides nothing: its superclass declares it, abstract.
goal ecj.MethodMustOverrideOrImplement needs overrides(symbol)

effect declare-in-superclass "declare ${name(m)}() in ${name(superclass(owner(m)))}"
  makes overrides(symbol)
  for m in methods-in(path, symbol)
  do
    declare-abstract-in-superclass ${m}
  end
end

# A new object no constructor makes: the class gets one that takes what the new passes.
goal ecj.UndefinedConstructor needs constructs(symbol)

effect create-constructor "create constructor in ${name(scope(unresolved-in(path, symbol, "new")))}"
  makes constructs(symbol)
  when nonempty(unresolved-in(path, symbol, "new"))
  do
    let made = unresolved-in(path, symbol, "new")
    let t = scope(made)
    let passed = arguments(made)
    c := create CONSTRUCTOR ${t} ${name(t)}
    for a in passed
      p := create PARAM ${c} ${first(a)}
      set ${p} type ${last(a)}
    end
  end
end

# A final field assigned where it may not be: java.rules says who may (and making it not final is deduced).

# An override that hides what it overrides: it is as visible again, or more (java.rules says how).
goal ecj.MethodReducesVisibility needs visible-as-overridden(inside(path, line, column))

# A type nothing declares: the file's package gets it, a class or an interface.
effect create-class "create class ${symbol} in ${qualified(owner(top-in(path)))}"
  makes resolves(symbol)
  when and(nonempty(unresolved-in(path, symbol, "type")), empty(types-named(symbol)))
  cost 3
  do
    create CLASS ${owner(top-in(path))} ${symbol}
  end
end

effect create-interface "create interface ${symbol} in ${qualified(owner(top-in(path)))}"
  makes resolves(symbol)
  when and(nonempty(unresolved-in(path, symbol, "type")), empty(types-named(symbol)))
  cost 4
  do
    create INTERFACE ${owner(top-in(path))} ${symbol}
  end
end
